#!/bin/bash
# Coolify splits multi-word start commands into an argv array, and the nixpacks
# entrypoint `bash -l -c` only consumes the first token — so a `cmd && cmd`
# start command silently runs only the first word. Keep startup in this single
# script and point Coolify's start command at `./start-prod` (one token).
set -e

# next.config.mjs uses `output: "standalone"`. Next does NOT copy .next/static
# or public/ into the standalone bundle, so the standalone server 404s on every
# asset unless we place them where it serves from. Idempotent for restarts.
rm -rf .next/standalone/.next/static .next/standalone/public
mkdir -p .next/standalone/.next
cp -r .next/static .next/standalone/.next/static
[ -d public ] && cp -r public .next/standalone/public

npx prisma migrate deploy && node .next/standalone/server.js
