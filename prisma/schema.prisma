generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MessageRole {
  system
  user
  assistant
  tool
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  azureOid  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chats            Chat[]
  purchaseRequests PurchaseRequest[]

  @@index([createdAt])
}

model Chat {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, updatedAt])
  @@index([createdAt])
}

model Message {
  id        String      @id @default(cuid())
  chatId    String
  role      MessageRole
  content   String
  metadata  Json?
  createdAt DateTime    @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

model Budget {
  id                String      @id @default(cuid())
  projectType       String
  projectTypeName   String
  budgetItemName    String
  year              Int
  budgetTHB         Decimal     @db.Decimal(20, 2)
  reservedTHB       Decimal     @db.Decimal(20, 2)
  actualTHB         Decimal     @db.Decimal(20, 2)
  availableTHB      Decimal     @db.Decimal(20, 2)
  budgetUSD         Decimal     @db.Decimal(20, 2)
  reservedUSD       Decimal     @db.Decimal(20, 2)
  actualUSD         Decimal     @db.Decimal(20, 2)
  availableUSD      Decimal     @db.Decimal(20, 2)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime @updatedAt

  purchaseRequestItems PurchaseRequestItem[]

  @@index([ createdAt])
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

model PurchaseRequest {
  id            String                @id @default(cuid())
  prNumber      String                @unique
  title         String
  description   String?
  requesterId   String
  department    String?
  status        PurchaseRequestStatus @default(DRAFT)
  currency      String                @default("THB")
  totalAmount   Decimal               @db.Decimal(20, 2) @default(0)
  notes         String?
  submittedAt   DateTime?
  approvedAt    DateTime?
  rejectedAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  requester User                  @relation(fields: [requesterId], references: [id])
  items     PurchaseRequestItem[]

  @@index([requesterId])
  @@index([status])
  @@index([createdAt])
}

model PurchaseRequestItem {
  id                  String   @id @default(cuid())
  purchaseRequestId   String
  budgetId            String
  description         String
  quantity            Int
  unit                String   @default("EA")
  unitPrice           Decimal  @db.Decimal(20, 2)
  totalPrice          Decimal  @db.Decimal(20, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  budget          Budget          @relation(fields: [budgetId], references: [id])

  @@index([purchaseRequestId])
  @@index([budgetId])
}