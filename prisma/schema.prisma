generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MessageRole {
  system
  user
  assistant
  tool
}

model User {
  id        String   @id @default(cuid())
  email       String    @unique
  name        String?
  image       String?
  phone       String?
  dateOfBirth DateTime? @db.Date
  azureOid    String?   @unique
  department  String?
  canSeeStaffBenefit Boolean @default(false)
  allowedMenus String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chats            Chat[]
  purchaseRequests PurchaseRequest[]
  carBookings      CarBooking[]
  carBookingPassengers CarBookingPassenger[]
  facilityInspections  FacilityQualityInspection[]
  activities           UserActivity[]

  @@index([createdAt])
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

model Chat {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, updatedAt])
  @@index([createdAt])
}

model Message {
  id        String      @id @default(cuid())
  chatId    String
  role      MessageRole
  content   String
  metadata  Json?
  createdAt DateTime    @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

model Budget {
  id                String      @id @default(cuid())
  projectType       String
  projectTypeName   String
  budgetItemName    String
  year              Int
  budgetTHB         Decimal     @db.Decimal(20, 2)
  reservedTHB       Decimal     @db.Decimal(20, 2)
  actualTHB         Decimal     @db.Decimal(20, 2)
  availableTHB      Decimal     @db.Decimal(20, 2)
  budgetUSD         Decimal     @db.Decimal(20, 2)
  reservedUSD       Decimal     @db.Decimal(20, 2)
  actualUSD         Decimal     @db.Decimal(20, 2)
  availableUSD      Decimal     @db.Decimal(20, 2)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime @updatedAt

  purchaseRequests PurchaseRequest[]

  @@index([ createdAt])
}

model CostTrackingProject {
  id              String    @id @default(cuid())
  projectCode     String    @unique
  projectName     String
  startDate       DateTime? @db.Date
  endDate         DateTime? @db.Date
  actualChargeUSD Decimal   @default(0) @db.Decimal(20, 2)
  estimateUSD     Decimal   @default(0) @db.Decimal(20, 2)
  budgetUSD       Decimal   @default(0) @db.Decimal(20, 2)
  exchangeRates   Json?
  budgetByItemCode Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  activities CostTrackingActivity[]

  @@index([createdAt])
}

model CostTrackingActivity {
  id             String   @id @default(cuid())
  projectId      String
  position       Int
  groupName      String
  description    String
  itemCode       String
  lumpSum        Decimal  @default(0) @db.Decimal(20, 2)
  rate           Decimal  @default(0) @db.Decimal(20, 6)
  invoiceLocal   Decimal  @default(0) @db.Decimal(20, 2)
  invoiceUSD     Decimal  @default(0) @db.Decimal(20, 2)
  sumPOLocal     Decimal  @default(0) @db.Decimal(20, 2)
  currency       String   @default("USD")
  sumPOUSD       Decimal  @default(0) @db.Decimal(20, 2)
  trackingAmount Decimal  @default(0) @db.Decimal(20, 4)
  poEstAmount    Decimal  @default(0) @db.Decimal(20, 2)
  dailyValues    Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project CostTrackingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([itemCode])
}

model BudgetDetail {
  id              String    @id @default(cuid())
  projectType     String
  projectCode     String
  budgetCategory  String
  budgetItemName  String
  system          String
  type            String
  no              String
  acctCode        String
  accountName     String
  date            DateTime? @db.Date
  vendor          String
  remark          String
  reservedTHB     Decimal   @db.Decimal(20, 2)
  actualTHB       Decimal   @db.Decimal(20, 2)
  totalSpentTHB   Decimal   @db.Decimal(20, 2)
  rate            Decimal   @db.Decimal(20, 6)
  reservedUSD     Decimal   @db.Decimal(20, 2)
  actualUSD       Decimal   @db.Decimal(20, 2)
  totalSpentUSD   Decimal   @db.Decimal(20, 2)
  creator         String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([projectType, budgetItemName])
  @@index([createdAt])
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum PurchaseStrategy {
  CALL_FOR_TENDER
  DIRECT_NEGOTIATION
}

enum PurchaseOrderType {
  PURCHASE_ORDER
  SERVICE_ORDER
}

model PurchaseRequest {
  id            String                @id @default(cuid())
  prNumber      String                @unique
  orderType     PurchaseOrderType     @default(PURCHASE_ORDER)
  title         String
  description   String?
  requesterId   String
  department    String?
  status        PurchaseRequestStatus @default(DRAFT)
  budgetId      String?
  currency      String                @default("THB")
  totalAmount   Decimal               @db.Decimal(20, 2) @default(0)
  notes         String?
  dueDate       DateTime?             @db.Date
  deliveryTo    String?
  proposedStrategy       PurchaseStrategy?
  businessJustification  String?
  submittedAt   DateTime?
  approvedAt    DateTime?
  rejectedAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  requester   User                        @relation(fields: [requesterId], references: [id])
  budget      Budget?                     @relation(fields: [budgetId], references: [id])
  items       PurchaseRequestItem[]
  attachments PurchaseRequestAttachment[]

  @@index([requesterId])
  @@index([status])
  @@index([budgetId])
  @@index([createdAt])
}

model PurchaseRequestAttachment {
  id                String   @id @default(cuid())
  purchaseRequestId String
  fileName          String
  fileKey           String   @unique
  fileSize          Int
  contentType       String
  uploadedAt        DateTime @default(now())

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  @@index([purchaseRequestId])
}

model PurchaseRequestItem {
  id                  String   @id @default(cuid())
  purchaseRequestId   String
  description         String
  quantity            Int
  unit                String   @default("EA")
  unitPrice           Decimal  @db.Decimal(20, 2)
  totalPrice          Decimal  @db.Decimal(20, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  @@index([purchaseRequestId])
}

enum CarBookingStatus {
  PENDING
  APPROVED
  REJECTED
  IN_USE
  RETURNED
  CANCELLED
}

model CarBooking {
  id              String           @id @default(cuid())
  bookingNumber   String           @unique
  userId          String
  projectCode     String?
  projectType     String?
  type            String?
  carName         String
  licensePlate    String
  purpose         String
  pickupLocation  String?
  destination     String?
  startDate     DateTime
  endDate       DateTime
  status        CarBookingStatus @default(PENDING)
  notes         String?
  approvedAt    DateTime?
  rejectedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user       User                 @relation(fields: [userId], references: [id])
  passengers CarBookingPassenger[]
  hotels     CarBookingHotel[]
  flights    CarBookingFlight[]
  trips      CarBookingTrip[]

  @@index([userId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([createdAt])
}

model CarBookingPassenger {
  id             String     @id @default(cuid())
  bookingId      String
  userId         String?
  role           String     @default("passenger")
  name           String
  email          String?
  phone          String?
  dateOfBirth    DateTime?  @db.Date
  usePersonalCar Boolean    @default(false)
  createdAt      DateTime   @default(now())

  booking CarBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User?      @relation(fields: [userId], references: [id])

  @@index([bookingId])
  @@index([userId])
}

model CarBookingHotel {
  id           String   @id @default(cuid())
  bookingId    String
  hotelName    String
  checkInDate  DateTime
  checkOutDate DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  booking CarBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model CarBookingFlight {
  id             String   @id @default(cuid())
  bookingId      String
  flightNumber   String?
  airline        String?
  route          String
  departureTime  DateTime
  arrivalTime    DateTime
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  booking CarBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model CarBookingTrip {
  id            String   @id @default(cuid())
  bookingId     String
  date          DateTime @db.Date
  departureTime DateTime
  arrivalTime   DateTime
  origin        String
  destination   String
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  booking CarBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([date])
}

enum InspectionStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  APPROVED
  REJECTED
}

enum InspectionResult {
  PASS
  FAIL
  CONDITIONAL
  PENDING
}

enum InspectionItemResult {
  PASS
  FAIL
  NA
  PENDING
}

model FacilityQualityInspection {
  id               String           @id @default(cuid())
  inspectionNumber String           @unique
  inspectorId      String
  facilityName     String
  facilityLocation String?
  inspectionType   String
  inspectionDate   DateTime         @db.Date
  status           InspectionStatus @default(DRAFT)
  overallResult    InspectionResult @default(PENDING)
  description      String?
  notes            String?
  scheduledAt      DateTime?
  completedAt      DateTime?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  inspector User                          @relation(fields: [inspectorId], references: [id])
  items     FacilityQualityInspectionItem[]

  @@index([inspectorId])
  @@index([status])
  @@index([inspectionDate])
  @@index([createdAt])
}

model FacilityQualityInspectionItem {
  id              String               @id @default(cuid())
  inspectionId    String
  category        String
  checkItem       String
  result          InspectionItemResult @default(PENDING)
  priority        String?
  correctiveAction String?
  actionParty     String?
  remarks         String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  inspection FacilityQualityInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}